{
  "name": "faria",
  "version": "1.0.2",
  "description": "Faria - The copilot for work on a computer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:native && vite",
    "build": "npm run build:native && tsc && rm -rf dist-electron && vite build && electron-builder",
    "build:native": "swiftc -O -o native/ax-extract native/ax-extract.swift && npx node-gyp rebuild -C native",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "release:local": "bash scripts/publish-local-release.sh"
  },
  "keywords": [
    "electron",
    "ai",
    "copilot",
    "automation"
  ],
  "author": "Madhavan",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@composio/core": "^0.5.2",
    "@composio/langchain": "^0.5.2",
    "@google/generative-ai": "^0.24.1",
    "@langchain/anthropic": "^1.3.17",
    "@langchain/core": "^1.1.24",
    "@langchain/google-genai": "^2.1.18",
    "@langchain/openai": "^1.2.13",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "electron-store": "^8.2.0",
    "langsmith": "^0.4.5",
    "openai": "^6.27.0",
    "uuid": "^10.0.0"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.15.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "culori": "^4.0.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "firebase": "^12.9.0",
    "marked": "^17.0.2",
    "node-addon-api": "^8.5.0",
    "pro-color-harmonies": "^0.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wrangler": "^4.76.0"
  },
  "build": {
    "appId": "com.faria.app",
    "productName": "Faria",
    "files": [
      "dist/**/*",
      "!dist/mac-arm64",
      "!dist/Faria-*",
      "!dist/*.blockmap",
      "dist-electron/**/*",
      "!node_modules/node-llama-cpp/**",
      "!node_modules/@node-llama-cpp/**"
    ],
    "artifactName": "Faria.${ext}",
    "dmg": {
      "background": "build/background.png",
      "iconSize": 80,
      "iconTextSize": 12,
      "window": {
        "width": 380,
        "height": 440
      },
      "contents": [
        {
          "x": 190,
          "y": 90,
          "type": "file"
        },
        {
          "x": 190,
          "y": 310,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": "build/notarize.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "notarize": false,
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Faria needs to send AppleScript commands to control applications.",
        "NSAccessibilityUsageDescription": "Faria needs accessibility access to read screen content and automate input."
      }
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/ax-extract",
        "to": "native/ax-extract"
      },
      {
        "from": "native/build/Release/window_helper.node",
        "to": "native/window_helper.node"
      },
      {
        "from": "build/trayIconTemplate.png",
        "to": "trayIconTemplate.png"
      },
      {
        "from": "build/trayIconTemplate@2x.png",
        "to": "trayIconTemplate@2x.png"
      }
    ]
  }
}
