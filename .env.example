# ── AI Provider Keys (used directly in dev mode or when set) ──────────────────
# At least one LLM key is required. You can also set these via Settings in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Proxy (required in production if not using direct API keys) ───────────────
# Deploy faria-proxy/ as a Cloudflare Worker and set the URL here.
# See faria-proxy/ for setup instructions.
# If unset, the app uses direct API keys only.
FARIA_PROXY_BASE=https://your-worker.workers.dev

# ── Optional: Tool integrations ───────────────────────────────────────────────
SERPER_API_KEY=
COMPOSIO_API_KEY=

# ── Optional: Embeddings ──────────────────────────────────────────────────────
# Set to 1 to force local embeddings instead of OpenAI
FARIA_LOCAL_EMBEDDINGS=

# ── Optional: LangSmith tracing ───────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=faria

# ── Release / notarization (maintainers only) ─────────────────────────────────
# Only needed when building and signing a distributable macOS app.
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── R2 / S3 (maintainers only) ────────────────────────────────────────────────
# Only needed when running scripts/publish-local-release.sh.
R2_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
